# ==============================================================================
# SMART MUNICIPAL CITIZEN ASSISTANCE AND STAFF ATTENDANCE MANAGEMENT SYSTEM
# FRONTEND MODULE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (or '.env.local' / '.env.development') and configure.
# Note: DO NOT commit your custom '.env*' files containing real local settings.

# ------------------------------------------------------------------------------
# API CONNECTION CONFIGURATION
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Base endpoint URL of the backend REST API gateway.
# Vite builds this into the production bundle, so make sure it's accessible.
# Default: http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# GLOBAL APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# VITE_APP_NAME: The public-facing name of the application displayed in headers and browser tabs.
# Default: Smart Municipal Assistant
VITE_APP_NAME=Smart Municipal Assistant

# ------------------------------------------------------------------------------
# FEATURE TOGGLES
# ------------------------------------------------------------------------------
# VITE_ENABLE_CHATBOT: Toggle visibility and integration of the Gemini-powered AI chatbot.
# Options: true, false
# Default: true
VITE_ENABLE_CHATBOT=true

# VITE_ENABLE_ATTENDANCE: Toggle access to the staff biometric/face recognition attendance portal.
# Options: true, false
# Default: true
VITE_ENABLE_ATTENDANCE=true

# VITE_ENABLE_FILE_TRACKING: Toggle access to the citizen file and application tracking search interface.
# Options: true, false
# Default: true
VITE_ENABLE_FILE_TRACKING=true

# ------------------------------------------------------------------------------
# REGIONALIZATION & MULTILINGUAL SUPPORT
# ------------------------------------------------------------------------------
# VITE_DEFAULT_LANGUAGE: The default language code loaded upon first visit.
# Options: en (English), ml (Malayalam)
# Default: en
VITE_DEFAULT_LANGUAGE=en
