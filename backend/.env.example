# ==============================================================================
# SMART MUNICIPAL CITIZEN ASSISTANCE AND STAFF ATTENDANCE MANAGEMENT SYSTEM
# BACKEND MODULE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and configure the variables for your local environment.
# Note: DO NOT commit the '.env' file containing actual secrets to the repository.

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# NODE_ENV: Defines the runtime environment. Options: development, production, test.
# Default: development
NODE_ENV=development

# PORT: The port number on which the backend Express server will run.
# Default: 5000
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MONGODB_URI: Full connection string to MongoDB.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Security: Contains sensitive credentials. Ensure strict access controls.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
# Security: MUST be a cryptographically strong, random string in production (at least 256 bits / 32 bytes).
# Example to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# JWT_EXPIRES_IN: The expiration period of the generated JWT session token.
# Format: Expressed in seconds or a string describing a timespan (e.g., '1h', '7d', '24h').
# Default: 7d
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS CONFIGURATION (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# CORS_ORIGIN: Allowed origin(s) that can interact with this API.
# Separate multiple origins with commas. Use exact URLs without trailing slashes.
# Example for Dev: http://localhost:3000
# Example for Prod: https://citizen-portal.municipality.gov
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# LOG_LEVEL: The minimum level of logs to capture.
# Options: error, warn, info, http, verbose, debug, silly.
# Default: info
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# ATTENDANCE & BIOMETRICS CONFIGURATION
# ------------------------------------------------------------------------------
# FACE_RECOGNITION_THRESHOLD: Confidence threshold above which a face verification is accepted.
# Value must be between 0.0 (lax) and 1.0 (strict). Recommend at least 0.8 to prevent false accepts.
# Default: 0.8
FACE_RECOGNITION_THRESHOLD=0.8

# ------------------------------------------------------------------------------
# FILE/APPLICATION TRACKING CONFIGURATION
# ------------------------------------------------------------------------------
# TRACKING_REFERENCE_PREFIX: Prefix code appended to every unique citizen application tracking number.
# Example: 'MC' (Municipal Council), 'CP' (Citizen Portal).
# Default: MC
TRACKING_REFERENCE_PREFIX=MC

# ------------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP) - OPTIONAL
# ------------------------------------------------------------------------------
# SMTP_HOST: Outgoing mail server host address.
SMTP_HOST=

# SMTP_PORT: Port used by the outgoing mail server. Typically 587 (TLS/STARTTLS) or 465 (SSL).
SMTP_PORT=

# SMTP_USER: Username (usually email address) for authenticating with the SMTP server.
SMTP_USER=

# SMTP_PASSWORD: Password or App Password for authenticating with the SMTP server.
# Security: Keep this secure and never expose it.
SMTP_PASSWORD=
