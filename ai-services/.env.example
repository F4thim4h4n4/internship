# ==============================================================================
# SMART MUNICIPAL CITIZEN ASSISTANCE AND STAFF ATTENDANCE MANAGEMENT SYSTEM
# AI MODULE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and configure the variables for the AI Services module.
# Note: DO NOT commit the '.env' file containing actual API keys to the repository.

# ------------------------------------------------------------------------------
# GEMINI API CONFIGURATION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Authentication key to access Google Gemini AI services.
# Security: Keep this key extremely secure. Never commit it to git or reveal it in frontend code.
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# AI ENGINE SETTINGS
# ------------------------------------------------------------------------------
# MODEL_NAME: The model name / version to use for the chatbot and content generation.
# Recommended: gemini-2.5-pro or gemini-2.5-flash
# Default: gemini-2.5-pro
MODEL_NAME=gemini-2.5-pro

# TEMPERATURE: Controls randomness in responses. 
# Lower values (e.g. 0.2) are more deterministic/focused, higher values (e.g. 0.9) are more creative.
# Default: 0.7
TEMPERATURE=0.7

# MAX_TOKENS: Maximum number of tokens to generate in a single model completion.
# Default: 2048
MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# MULTILINGUAL SUPPORT
# ------------------------------------------------------------------------------
# DEFAULT_LANGUAGE: Default locale code for chatbot prompts and system communications.
# Default: en
DEFAULT_LANGUAGE=en

# SUPPORTED_LANGUAGES: Comma-separated list of locale codes supported by the AI translation system.
# Default: en,ml (Malayalam)
SUPPORTED_LANGUAGES=en,ml

# ------------------------------------------------------------------------------
# OCR (OPTIONAL FEATURE TOGGLE)
# ------------------------------------------------------------------------------
# OCR_ENABLED: Enables or disables Optical Character Recognition on citizen application uploads.
# Options: true, false
# Default: true
OCR_ENABLED=true
