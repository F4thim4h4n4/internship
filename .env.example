# Environment Variables — Example File
# ─────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Obtain from: Atlas Console → Database → Connect → Drivers
# Use a DB user with the minimum required role (e.g. readWrite on municipality_db).
# Do NOT use an Atlas admin user for application connections.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority&appName=<AppName>
DB_NAME=municipality_db

# ── Authentication / JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
# bcrypt cost factor — 12 is recommended for production (higher = slower = more secure)
BCRYPT_SALT_ROUNDS=12

# ── Google Gemini API ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── AWS / S3 / KMS ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=your_aws_kms_key_id
S3_DOCUMENT_BUCKET=your_s3_document_bucket_name

# ── Internal Microservices ────────────────────────────────────────────────────
AI_GATEWAY_SERVICE_URL=http://localhost:8000
FACE_RECOGNITION_SERVICE_URL=http://localhost:8001
OCR_SERVICE_URL=http://localhost:8002

# ── Third-Party SaaS ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@municipality.gov
